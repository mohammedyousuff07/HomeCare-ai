# Local MongoDB: mongodb://127.0.0.1:27017
# Atlas example: mongodb+srv://<username>:<password>@<cluster-host>/
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=homecare_ai
AUTH_TOKEN_SECRET=replace-with-a-long-random-secret
DOCUMENT_ENCRYPTION_KEY=replace-with-a-separate-random-secret
# Set this temporarily when rotating an existing document key; keep the prior key until startup migration completes.
DOCUMENT_ENCRYPTION_KEY_PREVIOUS=
PORT=5001
CLIENT_URL=http://localhost:5173
VITE_API_URL=http://localhost:5001/api
# Optional, server-side LLM support for admin-reviewed optimal-code suggestions.
# If any setting is missing or a provider request fails, original code is the fallback.
CODE_LLM_ENDPOINT=
CODE_LLM_API_KEY=
CODE_LLM_MODEL=
